[Unit]
Description=Google Drive (rclone FUSE mount at %h/Drive)
Documentation=man:rclone(1)
# Best-effort network ordering; the mount also self-heals via Restart= below.
# Keep retrying forever when the network is down at login.
StartLimitIntervalSec=0
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
Environment=RCLONE_CONFIG=%h/.config/rclone/rclone.conf
ExecStartPre=/usr/bin/mkdir -p %h/Drive
ExecStart=/usr/bin/rclone mount gdrive: %h/Drive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --vfs-cache-max-age 168h \
  --vfs-write-back 5s \
  --dir-cache-time 1000h \
  --poll-interval 15s \
  --drive-export-formats docx,xlsx,pptx,svg \
  --umask 022 \
  --rc \
  --rc-addr 127.0.0.1:5572 \
  --rc-no-auth \
  --log-level INFO
ExecStop=/usr/bin/fusermount3 -uz %h/Drive
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
